// KChat — passkey-only chat
//
// Identity is the passkey, not an email or a username.
// Usernames are optional, non-unique display labels.
// Private encryption keys never touch the server: only the public half is stored.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  // Optional, non-unique. Null renders as "Anonymous".
  username            String?
  passkeyCredentialId String?   @unique
  passkeyPublicKey    String?
  passkeyCounter      BigInt?
  // Client-generated X25519 public key. The matching private key stays in the
  // browser's localStorage and is never transmitted.
  e2ePublicKey        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sentMessages     Message[]    @relation("SentMessages")
  receivedMessages Message[]    @relation("ReceivedMessages")
  chatSessions1    ChatSession[] @relation("Participant1Sessions")
  chatSessions2    ChatSession[] @relation("Participant2Sessions")
  challenges       WebAuthnChallenge[]
  verificationsAsA VerifiedKeyPair[] @relation("VerifiedByA")
  verificationsAsB VerifiedKeyPair[] @relation("VerifiedByB")
  sentVerifyRequests     VerificationRequest[] @relation("RequestSender")
  receivedVerifyRequests VerificationRequest[] @relation("RequestReceiver")
}

// A request to verify a conversation.
//
// This is a workflow device, not a security device: it carries the safety
// number to the other person and keeps the conversation open until both sides
// have compared it. The security property still comes entirely from the two
// humans comparing digits out of band.
//
// Because confirmation is always manual, a completed request carries no
// authority on its own — it does not mark either side verified by itself.
model VerificationRequest {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  chatSessionId String?
  // SHA-256 of the safety number for this key pair, so the receiving device can
  // check it is being asked about the conversation it thinks it is.
  numberHash String
  // "pending" -> awaiting the other person -> "completed" -> both compared
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  fromUser User @relation("RequestSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("RequestReceiver", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, status])
  @@index([fromUserId, status])
}

// Records that two users have compared safety numbers for a conversation.
//
// The server stores only the two user IDs and a hash of the safety number.
// Storing this here (rather than in the browser) means the verified state
// follows the account across devices.
//
// Note what the server does NOT get here: it never sees the safety number
// itself, and it cannot influence how the number is derived. The protection
// comes entirely from the two humans comparing numbers out of band — this
// table only remembers that they did.
model VerifiedKeyPair {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  // SHA-256 of the derived safety number, stored so a later key change can be
  // detected by recomputing and comparing.
  numberHash String
  // Each side confirms independently, so the two flags are tracked separately.
  // Both true is the only state that shows as fully verified.
  verifiedA   Boolean  @default(false)
  verifiedB   Boolean  @default(false)
  verifiedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userA User @relation("VerifiedByA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("VerifiedByB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

// A shareable link that delivers a safety number to the other person.
//
// Deliberately NOT an auto-verification mechanism: opening this page shows the
// number and nothing more. Anyone holding the link can open it, including the
// server, so a click must never mark a conversation verified. The number is
// only ever displayed for a human to compare.
model VerifyLink {
  id         String   @id @default(cuid())
  token      String   @unique
  fromUserId String
  peerId     String
  numberHash String
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
}

// Challenges are persisted server-side so the client can never choose the value
// it is later checked against. Previously the client echoed its own challenge
// back to /complete, which made the ceremony self-referential and meaningless.
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  challenge String   @unique
  // "registration" | "authentication"
  type      String
  // Nullable: an authentication challenge is issued before we know who will use it.
  userId    String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([expiresAt])
}

model ChatSession {
  id             String   @id @default(cuid())
  participant1Id String
  participant2Id String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  participant1 User      @relation("Participant1Sessions", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2 User      @relation("Participant2Sessions", fields: [participant2Id], references: [id], onDelete: Cascade)
  messages      Message[]

  @@unique([participant1Id, participant2Id])
  @@index([participant1Id])
  @@index([participant2Id])
}

model Message {
  id           String   @id @default(cuid())
  chatSessionId String
  senderId     String
  receiverId   String
  // base64( nonce || secretbox_ciphertext ). Opaque to the server.
  ciphertext   String
  timestamp    DateTime @default(now())
  delivered    Boolean  @default(false)
  read         Boolean  @default(false)

  chatSession ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  sender      User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User        @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([chatSessionId, timestamp])
}